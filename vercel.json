{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/food",
      "destination": "/#kitchen",
      "permanent": true
    },
    {
      "source": "/drink-menu",
      "destination": "/#cellar",
      "permanent": true
    },
    {
      "source": "/events",
      "destination": "/#events",
      "permanent": true
    },
    {
      "source": "/reach-out",
      "destination": "/#visit",
      "permanent": true
    },
    {
      "source": "/events/:path*",
      "destination": "/#events",
      "permanent": false
    }
  ]
}